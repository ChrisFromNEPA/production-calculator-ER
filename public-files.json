{
  "version": 2,
  "description": "Positive runtime allowlist for the static ER Calculator artifact.",
  "runtime": [
    "index.html",
    "favicon.svg",
    "manifest.webmanifest",
    "sw.js",
    "docs/assets/calculator-overview.png",
    "src/**/*.js",
    "src/**/*.css",
    "data/*.json",
    "fonts/*.woff2",
    "fonts/*.txt",
    "gear_textures/**/*.png",
    "icons/*.png",
    "icons/*.json",
    "maps/*.png",

    "voice_extracted/*.ogg"
  ],
  "budgets": {
    "max_bytes": 33554432,
    "max_files": 2000
  }
}
