{
  "version": 2,
  "description": "Positive runtime allowlist for the static ER Calculator artifact.",
  "runtime": [
    "index.html",
    "favicon.svg",
    "manifest.webmanifest",
    "sw.js",
    "docs/assets/calculator-sample.png",
    "src/**/*.js",
    "src/**/*.css",
    "data/*.json",
    "fonts/*.woff2",
    "fonts/*.txt",
    "gear_textures/**/*.png",
    "icons/*.png",
    "icons/*.json",
    "maps/*.png",

    "voice_extracted/*.ogg"
  ],
  "budgets": {
    "max_bytes": 209715200,
    "max_files": 3000
  },
  "excluded": [
    ".git",
    ".hermes",
    "cloudflare-worker",
    "empire-rising-scraper",
    "comms",
    "flyers",
    "wrangler.toml",
    "AGENT_HANDOFF.md",
    "REFACTOR_PLAN.md",
    "production_requests.json",
    "shared_inventory.json",
    "shared_gear_sets.json",
    "colony_taxes.json",
    "probe3.html",
    "probe_closeup.html",
    "probe_hold.html",
    "probe_turntable.html",
    "probe_uv.html",
    "tmp-zed-render.html"
  ]
}
